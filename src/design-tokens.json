{
  "name": "Replyo Design System Tokens",
  "version": "2.4.0",
  "description": "Enterprise Three-Layer Token Architecture for Replyo: Swiss Precision, Electric Cobalt & Deep Obsidian",
  "primitives": {
    "color": {
      "cobalt": {
        "50": "#eff6ff",
        "100": "#dbeafe",
        "200": "#bfdbfe",
        "300": "#93c5fd",
        "400": "#60a5fa",
        "500": "#3b82f6",
        "600": "#2563eb",
        "700": "#1d4ed8",
        "800": "#1e40af",
        "900": "#1e3a8a",
        "950": "#0f172a"
      },
      "obsidian": {
        "800": "#131a29",
        "900": "#090d16",
        "950": "#040711"
      },
      "slate": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a"
      },
      "emerald": {
        "50": "#ecfdf5",
        "100": "#d1fae5",
        "500": "#10b981",
        "600": "#059669",
        "700": "#047857"
      },
      "amber": {
        "50": "#fffbeb",
        "100": "#fef3c7",
        "400": "#fbbf24",
        "500": "#f59e0b",
        "600": "#d97706"
      },
      "rose": {
        "50": "#fff1f2",
        "100": "#ffe4e6",
        "500": "#f43f5e",
        "600": "#e11d48"
      },
      "white": "#ffffff",
      "black": "#000000"
    },
    "typography": {
      "fontFamily": {
        "heading": "Outfit, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "body": "'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', monospace"
      },
      "fontSize": {
        "2xs": "0.6875rem",
        "xs": "0.75rem",
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.125rem",
        "xl": "1.25rem",
        "2xl": "1.5rem",
        "3xl": "1.875rem",
        "4xl": "2.25rem",
        "5xl": "3rem"
      },
      "fontWeight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700",
        "extrabold": "800",
        "black": "900"
      },
      "lineHeight": {
        "tight": "1.15",
        "snug": "1.25",
        "normal": "1.5",
        "relaxed": "1.65"
      }
    },
    "spacing": {
      "1": "0.25rem",
      "1.5": "0.375rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "5": "1.25rem",
      "6": "1.5rem",
      "8": "2rem",
      "10": "2.5rem",
      "12": "3rem",
      "16": "4rem",
      "20": "5rem"
    },
    "borderRadius": {
      "none": "0",
      "sm": "0.375rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "xl": "1rem",
      "2xl": "1.25rem",
      "3xl": "1.5rem",
      "full": "9999px"
    },
    "shadow": {
      "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05)",
      "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.04)",
      "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.05)",
      "3d-cobalt": "0 16px 36px -12px rgba(37, 99, 235, 0.18)",
      "3d-glow": "0 0 25px rgba(37, 99, 235, 0.25)"
    }
  },
  "semantics": {
    "color": {
      "background": {
        "canvas": "var(--primitive-color-slate-50)",
        "surface": "var(--primitive-color-white)",
        "surface-subtle": "var(--primitive-color-slate-100)",
        "surface-inverse": "var(--primitive-color-obsidian-900)"
      },
      "text": {
        "primary": "var(--primitive-color-slate-900)",
        "secondary": "var(--primitive-color-slate-600)",
        "muted": "var(--primitive-color-slate-400)",
        "inverse": "var(--primitive-color-white)",
        "brand": "var(--primitive-color-cobalt-600)"
      },
      "brand": {
        "primary": "var(--primitive-color-cobalt-600)",
        "primary-hover": "var(--primitive-color-cobalt-700)",
        "primary-active": "var(--primitive-color-cobalt-800)",
        "subtle": "var(--primitive-color-cobalt-50)",
        "border": "var(--primitive-color-cobalt-200)"
      },
      "status": {
        "success": "var(--primitive-color-emerald-600)",
        "success-subtle": "var(--primitive-color-emerald-50)",
        "warning": "var(--primitive-color-amber-500)",
        "warning-subtle": "var(--primitive-color-amber-50)",
        "danger": "var(--primitive-color-rose-600)",
        "danger-subtle": "var(--primitive-color-rose-50)"
      },
      "border": {
        "subtle": "var(--primitive-color-slate-200)",
        "strong": "var(--primitive-color-slate-300)",
        "focus": "var(--primitive-color-cobalt-500)"
      }
    }
  },
  "components": {
    "qrPill": {
      "default": {
        "bg": "var(--primitive-color-slate-50)",
        "text": "var(--primitive-color-slate-700)",
        "border": "var(--primitive-color-slate-200)"
      },
      "selected": {
        "bg": "var(--primitive-color-cobalt-600)",
        "text": "var(--primitive-color-white)",
        "border": "var(--primitive-color-cobalt-600)"
      },
      "minHeight": "40px",
      "radius": "var(--primitive-borderRadius-lg)"
    },
    "buttonPrimary": {
      "default": {
        "bg": "var(--primitive-color-cobalt-600)",
        "text": "var(--primitive-color-white)",
        "shadow": "var(--primitive-shadow-sm)"
      },
      "hover": {
        "bg": "var(--primitive-color-cobalt-700)",
        "shadow": "var(--primitive-shadow-md)"
      },
      "active": {
        "bg": "var(--primitive-color-cobalt-800)"
      },
      "minHeight": "44px",
      "radius": "var(--primitive-borderRadius-xl)"
    },
    "card3D": {
      "bg": "var(--primitive-color-white)",
      "border": "1px solid var(--primitive-color-slate-200)",
      "radius": "var(--primitive-borderRadius-3xl)",
      "shadow": "var(--primitive-shadow-sm)",
      "hoverShadow": "var(--primitive-shadow-3d-cobalt)",
      "hoverTransform": "translateY(-2px)"
    },
    "badgeQuarantine": {
      "bg": "var(--primitive-color-amber-50)",
      "text": "var(--primitive-color-amber-600)",
      "border": "1px solid var(--primitive-color-amber-400)"
    },
    "badgeAutopilot": {
      "bg": "var(--primitive-color-emerald-50)",
      "text": "var(--primitive-color-emerald-700)",
      "border": "1px solid var(--primitive-color-emerald-500)"
    }
  }
}
