{
  "name": "ReviewKare Design System Tokens",
  "version": "2.4.0",
  "description": "Enterprise Three-Layer Token Architecture for ReviewKare: Brex White Concrete, Single Ember Accent, Inter Engineered Typography",
  "primitives": {
    "color": {
      "ember": "#ff5900",
      "abyss": "#000710",
      "carbon": "#15191e",
      "ink": "#000000",
      "paper": "#ffffff",
      "fog": "#f3f3f7",
      "mist": "#b9bbc6",
      "steel": "#8b8d98",
      "pewter": "#6f737b",
      "graphite": "#60646c",
      "brand": {
        "50": "#fff7ed",
        "100": "#ffedd5",
        "200": "#fed7aa",
        "300": "#fdba74",
        "400": "#fb923c",
        "500": "#f97316",
        "600": "#ff5900",
        "700": "#ea580c",
        "800": "#c2410c",
        "900": "#9a3412",
        "950": "#000710"
      },
      "dark": {
        "900": "#15191e",
        "950": "#000710"
      },
      "emerald": {
        "50": "#ecfdf5",
        "100": "#d1fae5",
        "500": "#10b981",
        "600": "#059669",
        "700": "#047857"
      },
      "amber": {
        "50": "#fffbeb",
        "100": "#fef3c7",
        "400": "#fbbf24",
        "500": "#f59e0b",
        "600": "#d97706"
      },
      "rose": {
        "50": "#fff1f2",
        "100": "#ffe4e6",
        "500": "#f43f5e",
        "600": "#e11d48"
      },
      "white": "#ffffff",
      "black": "#000000"
    },
    "typography": {
      "fontFamily": {
        "heading": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "body": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', monospace"
      },
      "letterSpacing": {
        "display": "-0.03em",
        "headingLg": "-0.025em",
        "heading": "-0.02em",
        "body": "-0.01em"
      },
      "fontSize": {
        "caption": "12px",
        "bodySm": "14px",
        "body": "16px",
        "subheading": "20px",
        "headingSm": "24px",
        "heading": "36px",
        "headingLg": "48px",
        "display": "72px"
      },
      "fontWeight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "lineHeight": {
        "display": "1.0",
        "headingLg": "1.20",
        "heading": "1.21",
        "headingSm": "1.33",
        "subheading": "1.40",
        "bodySm": "1.43",
        "body": "1.50"
      }
    },
    "spacing": {
      "8": "8px",
      "16": "16px",
      "24": "24px",
      "32": "32px",
      "48": "48px",
      "72": "72px",
      "80": "80px",
      "160": "160px"
    },
    "borderRadius": {
      "none": "0px",
      "tag": "6px",
      "card": "12px",
      "input": "12px",
      "button": "12px",
      "full": "9999px"
    },
    "shadow": {
      "none": "none",
      "hairline": "0 0 0 1px #b9bbc6",
      "card": "0 1px 3px 0 rgba(0, 7, 16, 0.04)",
      "cardHover": "0 16px 36px -12px rgba(255, 89, 0, 0.12)"
    }
  },
  "semantics": {
    "color": {
      "background": {
        "canvas": "var(--primitive-color-paper)",
        "surface": "var(--primitive-color-paper)",
        "surfaceSubtle": "var(--primitive-color-fog)",
        "surfaceInverse": "var(--primitive-color-abyss)",
        "announcement": "var(--primitive-color-carbon)"
      },
      "text": {
        "primary": "var(--primitive-color-ink)",
        "secondary": "var(--primitive-color-graphite)",
        "tertiary": "var(--primitive-color-pewter)",
        "muted": "var(--primitive-color-steel)",
        "inverse": "var(--primitive-color-paper)",
        "accent": "var(--primitive-color-ember)"
      },
      "border": {
        "hairline": "var(--primitive-color-mist)",
        "dark": "var(--primitive-color-carbon)"
      }
    }
  },
  "components": {
    "topBar": {
      "bg": "var(--primitive-color-carbon)",
      "text": "var(--primitive-color-paper)",
      "accent": "var(--primitive-color-ember)"
    },
    "buttonPrimary": {
      "bg": "var(--primitive-color-ember)",
      "text": "var(--primitive-color-paper)",
      "radius": "12px",
      "padding": "8px 16px",
      "weight": "600"
    },
    "buttonGhost": {
      "bg": "transparent",
      "text": "var(--primitive-color-ink)",
      "weight": "500"
    },
    "card": {
      "bg": "var(--primitive-color-paper)",
      "radius": "12px",
      "padding": "24px 32px",
      "border": "1px solid var(--primitive-color-mist)"
    },
    "footer": {
      "bg": "var(--primitive-color-abyss)",
      "text": "var(--primitive-color-mist)",
      "heading": "var(--primitive-color-paper)"
    }
  }
}
