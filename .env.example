NODE_ENV=development
# Production must use https://reviewkare.in (or the canonical domain you deploy).
BASE_URL=http://localhost:3000
PORT=3000
# Local SQLite only. On Render Free use DATABASE_URL instead.
DATA_DIR=.runtime
DATABASE_URL=
# Optional trusted CA certificate in PEM format.
DATABASE_CA_CERT=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only credential for account deletion.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GOOGLE_SIGN_IN=false
OPERATOR_NAME=
SUPPORT_EMAIL=
HOSTING_REGION=
DATABASE_REGION=
# Google Business Profile connection. Leave disabled until the Cloud project,
# OAuth client, and Business Profile API access are ready.
GOOGLE_BUSINESS_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://reviewkare.in/api/google/callback
# 32-byte key, base64 encoded. Required when Google connection is enabled.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_ID=v1
# During a planned rotation only, use a new current key/version and retain the old one for reads.
TOKEN_ENCRYPTION_PREVIOUS_KEY=
TOKEN_ENCRYPTION_PREVIOUS_KEY_ID=
# Optional Search Console / Bing Webmaster verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
RESEND_API_KEY=
EMAIL_FROM=
# Keep disabled until live payment, tax, and refund operations are verified.
BILLING_ENABLED=false
TAX_POLICY_CONFIRMED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Enable only behind a proxy that sanitizes the right-most forwarded address.
TRUST_PROXY=false
# Optional multi-model AI drafts. Off by default; each workspace must also opt in.
AI_DRAFTS_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated allowlisted IDs from src/server/ai-models.js. Empty = five free models.
AI_MODELS=
AI_REQUEST_TIMEOUT_MS=8000
AI_TOTAL_TIMEOUT_MS=12000
AI_REDACT_PII=true
AI_MONTHLY_GENERATIONS=500
AI_TENANT_MONTHLY_BUDGET_USD=1
AI_MONTHLY_BUDGET_USD=20
# Empty = every workspace may opt in. Otherwise a comma-separated tenant ID list.
AI_TENANT_ALLOWLIST=

# Approved paise amounts for all twelve offers. Keys: basic, growth, pro; each maps 1, 3, 6, 12 to an integer.
BILLING_TERM_PRICES=
BILLING_RECEIPT_FOOTER=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=
# Set a random value of at least 32 characters for an external scheduler.
JOBS_SECRET=
LIFECYCLE_ENABLED=false
LIFECYCLE_DELETE_ENABLED=false

# Enable only after provisioning named Supabase administrator accounts with verified TOTP.
ADMIN_ENABLED=false
ANALYTICS_ENABLED=false
SENTRY_DSN=
GRIEVANCE_OFFICER=
GOOGLE_POLICY_VERIFIED=false
